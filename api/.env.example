# Conexão com o PostgreSQL
DATABASE_URL=postgresql://ariano:ariano@localhost:5432/ariano
ARIANO_POOL_MIN=1
ARIANO_POOL_MAX=10

# Caminho da biblioteca compilada do motor em C.
# Se não for definido, a API procura em
# ../Matching-ariano-c/matching_engine/build/libariano.so (Linux)
# ou libariano.dll (Windows)
# ARIANO_ENGINE_LIB=/caminho/para/libariano.so

# Scraper chamado por subprocesso na ingestão de PDF.
# ARIANO_SCRAPER_DIR=../scrapper-py/ariano_scraper
# ARIANO_SCRAPER_PYTHON=../scrapper-py/ariano_scraper/.venv/bin/python
ARIANO_SCRAPER_TIMEOUT=120
